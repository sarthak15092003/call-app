# ==============================================================================
# SmartCall CRM – Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Credentials
# ------------------------------------------------------------------------------
# In development / demo mode, the application automatically uses the local enterprise store.
# Once your Supabase project is created, insert your credentials below:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# ------------------------------------------------------------------------------
# 2. Telephony Providers (Exotel / MyOperator)
# ------------------------------------------------------------------------------
# Default mode is 'demo'. Set to 'exotel' or 'myoperator' to activate live telecom routing.
TELEPHONY_PROVIDER=demo
TELEPHONY_WEBHOOK_SECRET=smartcall_wh_secret_2026

# Exotel Credentials
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_CALLER_ID=08047190000

# MyOperator Credentials
MYOPERATOR_TOKEN=your_myoperator_bearer_token
MYOPERATOR_COMPANY_ID=your_company_id
MYOPERATOR_CALLER_ID=01149200000

# ------------------------------------------------------------------------------
# 3. Automated Evening Reporting Schedule
# ------------------------------------------------------------------------------
DAILY_REPORT_SCHEDULE=18:00
DAILY_REPORT_TIMEZONE=Asia/Kolkata
DAILY_REPORT_EMAILS=sales-ops@smartcall.com,director@smartcall.com
